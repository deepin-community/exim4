---
 src/string.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/string.c b/src/string.c
index b7500bd5f..e81c2f084 100644
--- a/src/string.c
+++ b/src/string.c
@@ -634,11 +634,11 @@ while (*s)
     uschar c = *s++ - '0';
     if (isdigit(*s)) c = c * 10 + *s++ - '0';
     if (isdigit(*s)) c = c * 10 + *s++ - '0';
     *ss++ = c;
     }
-  else if (*++s)
+  else if (*s)
     *ss++ = *s++;
 
 *ss = 0;
 return yield;
 }
